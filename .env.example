# EMICODE Environment Configuration

# Neon PostgreSQL Database Connection URL (from https://console.neon.tech)
# Add the real private connection string in .env or Vercel Environment Variables.
DATABASE_URL=""

# JWT Secret for Admin Authentication Session (min 32 characters)
JWT_SECRET=""

# Optional first-run superadmin bootstrap. Leave empty in this example file.
# Set real values only in Vercel Environment Variables or a private local .env.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Node Environment ('development' or 'production')
NODE_ENV="production"

# Port (defaults to 3000)
PORT=3000

# Application Public URL
APP_URL="https://your-project.vercel.app"
