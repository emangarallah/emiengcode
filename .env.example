# EMICODE local environment template
# Copy this file to .env locally, then replace every placeholder privately.
# Never commit .env or paste secrets into chat.

# Neon PostgreSQL connection string (obtain from your Neon project dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate a unique random secret (at least 32 characters) for signing admin sessions.
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Optional one-time first-admin bootstrap. Set both only in a private environment.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
