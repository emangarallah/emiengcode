# EMICODE Environment Configuration

# Neon PostgreSQL Database Connection URL (from https://console.neon.tech)
# Example: postgresql://neondb_owner:npg_xyz@ep-fancy-pool.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pool.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Admin Authentication Session (min 32 characters)
JWT_SECRET="your-super-secure-production-jwt-secret-min-32-chars"

# Authorized Admin Credentials (Managed privately on server, never exposed to clients)
ADMIN_EMAIL="emanjarallah646@gmail.com"
