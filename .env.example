# EMICODE local environment template
# Copy to .env for local development. Never commit .env or share secret values.
# Production values belong in Vercel Project Settings > Environment Variables.

# Neon PostgreSQL connection string: replace with a FRESH connection string
# after rotating the exposed Neon password. Do not use the previously shared credential.
DATABASE_URL="postgresql://USER:NEW_PASSWORD@YOUR_NEON_HOST/DB_NAME?sslmode=require"

# Generate a unique random secret with at least 32 characters.
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Optional first-admin bootstrap. Use a real email and a unique password of 12+ characters.
# Do not use example.com or a sample/default password.
ADMIN_EMAIL="your-admin-email@your-domain.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"

NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
